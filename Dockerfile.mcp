# ===========================================
# KAG MCP Server — тонкий образ поверх kag-base
# ===========================================
# Раньше собирался из собственного Dockerfile (только requirements.txt,
# 1.67 ГБ) — теперь наследует kag-base, поэтому отдельного набора зависимостей
# нет. Проверено: src/mcp/ не импортирует occular/docling/torch.
#
# Сборка (СНАЧАЛА kag-base той же версии):
#   docker build -t kre44et/kag-mcp:2026.09.07 -f Dockerfile.mcp .
#   docker push kre44et/kag-mcp:2026.09.07

FROM kre44et/kag-base:2026.09.07

LABEL maintainer="KAG Team"
LABEL description="KAG MCP Server (Model Context Protocol over HTTP)"
LABEL version="0.1.0"

COPY --chown=kag:kag src/ /app/src/

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')" || exit 1

USER kag

CMD ["uvicorn", "src.mcp.server:app", "--host", "0.0.0.0", "--port", "8001"]
