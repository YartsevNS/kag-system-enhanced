define
# Схема онтологии KAG (TypeDB), сгенерирована из живого состояния.
# Формат TypeQL 3.x: каждый owns/relates/plays — отдельным определением,
# несколько инструкций define в одном тексте недопустимы.
  attribute category, value string;
  attribute cii-category, value integer;
  attribute code, value string;
  attribute current_version_string, value string;
  attribute description, value string;
  attribute doc_type, value string;
  attribute document_key, value string;
  attribute effective_from, value date;
  attribute effective_to, value date;
  attribute ent-key, value string;
  attribute is-certified, value boolean;
  attribute kag_document_id, value string;
  attribute name, value string;
  attribute number, value string;
  attribute obligation-level, value string;
  attribute offender_class, value string;
  attribute potential, value string;
  attribute requirement-id, value string;
  attribute requirement_kind, value string;
  attribute short_name, value string;
  attribute source-chunk-id, value string;
  attribute source-chunk-ids, value string;
  attribute source-clause, value string;
  attribute source_origin, value string;
  attribute struct_index, value string;
  attribute system_type, value string;
  attribute text_content, value string;
  attribute title, value string;
  attribute version_hash, value string;
  attribute version_status, value string;
  attribute version_string, value string;
  entity cii_object;
  entity cii_object owns category;
  entity cii_object owns cii-category;
  entity cii_object owns ent-key;
  entity cii_object owns name;
  entity cii_object owns source-chunk-id;
  entity cii_object owns source-chunk-ids;
  entity cii_object owns source-clause;
  entity cii_object owns source_origin;
  entity cii_object owns system_type;
  entity company_document;
  entity company_document owns document_key;
  entity company_document owns ent-key;
  entity company_document owns source-chunk-id;
  entity company_document owns source-chunk-ids;
  entity company_document owns source-clause;
  entity company_document owns source_origin;
  entity company_document owns title;
  entity company_document owns version_string;
  entity document_version;
  entity document_version owns effective_from;
  entity document_version owns effective_to;
  entity document_version owns ent-key;
  entity document_version owns kag_document_id;
  entity document_version owns source-chunk-id;
  entity document_version owns source_origin;
  entity document_version owns version_hash;
  entity document_version owns version_status;
  entity document_version owns version_string;
  entity evidence;
  entity evidence owns ent-key;
  entity evidence owns name;
  entity evidence owns source-chunk-id;
  entity evidence owns source-chunk-ids;
  entity evidence owns source_origin;
  entity regulator;
  entity regulator owns ent-key;
  entity regulator owns name;
  entity regulator owns short_name;
  entity regulator owns source-chunk-id;
  entity regulator owns source-chunk-ids;
  entity regulator owns source-clause;
  entity regulator owns source_origin;
  entity regulatory_document;
  entity regulatory_document owns current_version_string;
  entity regulatory_document owns doc_type;
  entity regulatory_document owns document_key;
  entity regulatory_document owns ent-key;
  entity regulatory_document owns number;
  entity regulatory_document owns source-chunk-id;
  entity regulatory_document owns source-chunk-ids;
  entity regulatory_document owns source-clause;
  entity regulatory_document owns source_origin;
  entity regulatory_document owns title;
  entity security_measure;
  entity security_measure owns code;
  entity security_measure owns description;
  entity security_measure owns ent-key;
  entity security_measure owns source-chunk-id;
  entity security_measure owns source-chunk-ids;
  entity security_measure owns source-clause;
  entity security_measure owns source_origin;
  entity security_requirement;
  entity security_requirement owns description;
  entity security_requirement owns ent-key;
  entity security_requirement owns obligation-level;
  entity security_requirement owns requirement-id;
  entity security_requirement owns requirement_kind;
  entity security_requirement owns source-chunk-id;
  entity security_requirement owns source-chunk-ids;
  entity security_requirement owns source-clause;
  entity security_requirement owns source_origin;
  entity security_software;
  entity security_software owns ent-key;
  entity security_software owns is-certified;
  entity security_software owns name;
  entity security_software owns source-chunk-id;
  entity security_software owns source-chunk-ids;
  entity security_software owns source_origin;
  entity structural_element;
  entity structural_element owns ent-key;
  entity structural_element owns source-chunk-id;
  entity structural_element owns source-chunk-ids;
  entity structural_element owns source-clause;
  entity structural_element owns source_origin;
  entity structural_element owns struct_index;
  entity structural_element owns text_content;
  entity threat_source;
  entity threat_source owns ent-key;
  entity threat_source owns offender_class;
  entity threat_source owns potential;
  entity threat_source owns source-chunk-id;
  entity threat_source owns source-chunk-ids;
  entity threat_source owns source-clause;
  entity threat_source owns source_origin;
  relation applicability_criteria;
  relation applicability_criteria relates applied_requirement;
  relation applicability_criteria relates target_system;
  relation asset_protection;
  relation asset_protection relates deployed_szi;
  relation asset_protection relates protected_system;
  relation compensatory_relation;
  relation compensatory_relation relates alternative_measure;
  relation compensatory_relation relates core_measure;
  relation document_assignment;
  relation document_assignment relates regulated_doc;
  relation document_assignment relates regulated_subject;
  relation document_hierarchy;
  relation document_hierarchy relates structural_part;
  relation document_hierarchy relates sub_part;
  relation document_issuance;
  relation document_issuance relates issuer;
  relation document_issuance relates regulated_item;
  relation document_version_of;
  relation document_version_of relates document;
  relation document_version_of relates version;
  relation measure_definition;
  relation measure_definition relates core_measure;
  relation measure_definition relates source_requirement;
  relation requirement_basis;
  relation requirement_basis relates requirement;
  relation requirement_basis relates source_document;
  relation requirement_evidence;
  relation requirement_evidence relates evidence;
  relation requirement_evidence relates requirement;
  relation supersedes;
  relation supersedes relates newer;
  relation supersedes relates older;
  entity cii_object plays applicability_criteria:target_system;
  entity cii_object plays asset_protection:protected_system;
  entity cii_object plays document_assignment:regulated_subject;
  entity company_document plays document_assignment:regulated_doc;
  entity company_document plays document_version_of:document;
  entity document_version plays document_version_of:version;
  entity document_version plays supersedes:newer;
  entity document_version plays supersedes:older;
  entity evidence plays requirement_evidence:evidence;
  entity regulator plays document_issuance:issuer;
  entity regulatory_document plays document_issuance:regulated_item;
  entity regulatory_document plays document_version_of:document;
  entity regulatory_document plays requirement_basis:source_document;
  entity security_measure plays applicability_criteria:applied_requirement;
  entity security_measure plays compensatory_relation:alternative_measure;
  entity security_measure plays compensatory_relation:core_measure;
  entity security_measure plays measure_definition:core_measure;
  entity security_requirement plays requirement_basis:requirement;
  entity security_requirement plays requirement_evidence:requirement;
  entity security_software plays asset_protection:deployed_szi;
  entity structural_element plays applicability_criteria:applied_requirement;
  entity structural_element plays document_hierarchy:structural_part;
  entity structural_element plays document_hierarchy:sub_part;
  entity structural_element plays measure_definition:source_requirement;
