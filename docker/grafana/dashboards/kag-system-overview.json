{
  "id": null,
  "uid": "kag-system-overview",
  "title": "KAG — состояние системы",
  "description": "Что происходит внутри: запросы, время по стадиям, ответы и отказы, отбор контекста, реранкер, токены и стоимость, оценки пользователей. Источник — /metrics нашего api.",
  "tags": [
    "kag",
    "rag",
    "наблюдаемость"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Главное",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Запросов в секунду",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Доля ошибок (4xx/5xx)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "unit": "percent"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{status=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.0001)",
          "legendFormat": "ошибки %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 ответа чата, с",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{endpoint=~\"/api/v1/chat.*\"}[10m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Доля модели во времени ответа",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "unit": "percent"
      },
      "description": "Если 80–90% — оптимизировать поиск бессмысленно, рычаг в модели (кэш префикса, меньшая модель, стриминг).",
      "targets": [
        {
          "expr": "100 * (sum(rag_stage_duration_seconds_sum{stage=\"llm\"}) / clamp_min(sum(rag_stage_duration_seconds_sum), 0.0001))",
          "legendFormat": "модель %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Ответы: успешные за час, %",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "unit": "percent"
      },
      "targets": [
        {
          "expr": "100 * sum(increase(rag_answers_total{status=\"ok\"}[1h])) / clamp_min(sum(increase(rag_answers_total[1h])), 0.0001)",
          "legendFormat": "ok %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Отказы за час",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "description": "Честные «не найдено» и отсечения порогом. Рост при растущем корпусе — сигнал разбирать поиск.",
      "targets": [
        {
          "expr": "sum(increase(rag_answers_total{status=~\"refusal.*\"}[1h]))",
          "legendFormat": "отказы",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Время по стадиям ответа",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Стадии RAG: p95, с",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(rag_stage_duration_seconds_bucket[10m])))",
          "legendFormat": "{{stage}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Стадии RAG: вызовов в минуту",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum by (stage) (rate(rag_stage_duration_seconds_count[5m])) * 60",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Ответы, отбор и качество",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Итог ответов по статусам (за 10 мин)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(rag_answers_total[10m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Длина ответа: p50 и p95, символов",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rag_answer_length_chars_bucket[30m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_answer_length_chars_bucket[30m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Фрагментов в промпте и отсечено порогом",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "description": "Сколько контекста уходит в модель и сколько «хвоста» отсекает порог релевантности.",
      "targets": [
        {
          "expr": "sum(rate(rag_context_fragments_sum[10m])) / clamp_min(sum(rate(rag_context_fragments_count[10m])), 0.0001)",
          "legendFormat": "в промпте, среднее",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rag_cutoff_dropped_fragments_sum[10m])) / clamp_min(sum(rate(rag_cutoff_dropped_fragments_count[10m])), 0.0001)",
          "legendFormat": "отсечено, среднее",
          "refId": "B"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Модель: токены, стоимость, пользователи",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Токены в минуту (промпт / ответ)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum(rate(llm_tokens_total{type=\"prompt\"}[5m])) * 60",
          "legendFormat": "промпт",
          "refId": "A"
        },
        {
          "expr": "sum(rate(llm_tokens_total{type=\"completion\"}[5m])) * 60",
          "legendFormat": "ответ",
          "refId": "B"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Вызовы модели по моделям и статусам",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum by (model, status) (rate(llm_requests_total[5m])) * 60",
          "legendFormat": "{{model}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Реранкер: доля изменений топ-1",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 25
      },
      "description": "Ниже 5% — реранкер тратит время впустую.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "unit": "percent"
      },
      "targets": [
        {
          "expr": "100 * sum(rag_reranker_changed_top1_total) / clamp_min(sum(rag_reranker_runs_total), 0.0001)",
          "legendFormat": "изменений",
          "refId": "A"
        }
      ]
    },
    {
      "id": 34,
      "type": "stat",
      "title": "Оценки ответов: 👍 / 👎",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 25
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(rag_feedback_total{value=\"up\"})",
          "legendFormat": "👍",
          "refId": "A"
        },
        {
          "expr": "sum(rag_feedback_total{value=\"down\"})",
          "legendFormat": "👎",
          "refId": "B"
        }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "HTTP: ручки и задержки",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "panels": [
        {
          "id": 41,
          "type": "timeseries",
          "title": "HTTP: p95 по ручкам, с",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 34
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[10m])))",
              "legendFormat": "{{endpoint}}",
              "refId": "A"
            }
          ]
        },
        {
          "id": 42,
          "type": "timeseries",
          "title": "HTTP: запросы по статусам",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 34
          },
          "targets": [
            {
              "expr": "sum by (status) (rate(http_requests_total[5m])) * 60",
              "legendFormat": "{{status}}",
              "refId": "A"
            }
          ]
        }
      ]
    }
  ]
}