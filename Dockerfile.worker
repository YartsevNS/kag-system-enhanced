# ===========================================
# Stage 1: Build
# ===========================================
FROM python:3.11-slim as builder

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    # OCR: Tesseract + русский язык + poppler для pdf2image
    tesseract-ocr \
    tesseract-ocr-rus \
    poppler-utils \
    # OpenCV/GL для Occular-ocr
    libgl1 \
    libglib2.0-0t64 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    # Occular-ocr — русский OCR из GitHub (ставим без зависимостей — torch уже есть)
    pip install --no-cache-dir --no-deps git+https://github.com/Bodhi42/Occular-ocr.git && \
    # pyctcdecode — зависимость Occular (декодирование CTC), не ставится с --no-deps
    pip install --no-cache-dir pyctcdecode && \
    # Playwright — headless Chromium для парсинга SPA-сайтов (тип источника browser)
    python -m playwright install --with-deps chromium && \
    # Веса для Occular — 3 retry с verify
    mkdir -p /opt/venv/lib/python3.11/site-packages/ocr_skel/weights && \
    cd /opt/venv/lib/python3.11/site-packages/ocr_skel/weights && \
    for url in \
      "https://raw.githubusercontent.com/Bodhi42/Occular-ocr/main/ocr_skel/weights/dbnet.onnx" \
      "https://raw.githubusercontent.com/Bodhi42/Occular-ocr/main/ocr_skel/weights/dbnet_weights.pth" \
      "https://raw.githubusercontent.com/Bodhi42/Occular-ocr/main/ocr_skel/weights/crnn_encoder.onnx" \
      "https://raw.githubusercontent.com/Bodhi42/Occular-ocr/main/ocr_skel/weights/crnn_mobilenet_large.pth"; do \
      f="${url##*/}"; \
      for i in 1 2 3; do \
        echo "Downloading $f (attempt $i)..." && \
        curl --connect-timeout 30 --max-time 120 -sSLO "$url" && \
        [ -s "$f" ] && echo "OK $f ($(stat -c%s "$f") bytes)" && break; \
        echo "Retry $i failed for $f"; \
        if [ $i -eq 3 ]; then exit 1; fi; \
        sleep 2; \
      done; \
    done && \
    # Предзагрузка модели reading_order (многоколоночные макеты) — чтобы
    # не качалась в рантайме при первом документе
    cd /opt/venv/lib/python3.11/site-packages/ocr_skel && \
    python -c "from ocr_skel import download_reading_order; download_reading_order()" \
    || echo "WARNING: reading_order model download failed, will download at runtime"

# ===========================================
# Stage 2: Production
# ===========================================
FROM python:3.11-slim as production

LABEL maintainer="KAG Team"
LABEL description="KAG Celery Worker"
LABEL version="0.1.0"

RUN apt-get update && apt-get install -y \
    curl \
    # OCR runtime
    tesseract-ocr \
    tesseract-ocr-rus \
    poppler-utils \
    libgl1 \
    libglib2.0-0t64 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN groupadd -r kag && useradd -r -g kag -d /app -s /sbin/nologin kag

WORKDIR /app

COPY --chown=kag:kag src/ /app/src/

RUN mkdir -p /app/models && chown -R kag:kag /app/models || true
RUN mkdir -p /app/data && chown -R kag:kag /app/data

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH"

USER kag

HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 \
    CMD celery -A src.indexing.celery_app inspect ping || exit 1

CMD ["celery", "-A", "src.indexing.celery_app", "worker", "--loglevel=info", "--pool=solo", "-B", "-Q", "documents,celery,maintenance"]
