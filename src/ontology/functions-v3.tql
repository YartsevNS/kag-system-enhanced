define
# =====================================================================
#  ФУНКЦИИ ВЫВОДА v3.2 (ревью 08.11.2026: убрана multiple_issuers,
#  violated_documents → uncovered_documents, expired → invalid_certificates)
#
#  Исправлено против первой редакции:
#   1) violated_certification учитывает requirement_applicability:
#      без этого требование приписывалось любому объекту 1-й категории;
#   2) срок сертификата проверяется датой: просроченный сертификат
#      больше не считается выполнением требования;
#   3) current_versions считается по current_version_of, а не по
#      отсутствию supersedes (иначе «сирота» без цепочки считалась текущей).
# =====================================================================
fun violated_certification($today: date) -> { cii_object, security_requirement, security_software }:
    match
      $asset isa cii_object, has cii-category 1;
      $law isa security_requirement, has requirement_kind "certification";
      requirement_applicability(requirement: $law, target_system: $asset);
      asset_protection(protected_system: $asset, deployed_szi: $szi);
      not {
        certification(certified_software: $szi, certificate: $c);
        $c has cert_until $until;
        $until > $today;
      };
    return { $asset, $law, $szi };

fun uncovered_documents() -> { company_document, security_requirement }:
    match
      $doc isa company_document;
      document_assignment(regulated_subject: $asset, regulated_doc: $doc);
      $asset isa cii_object, has cii-category 1;
      $law isa security_requirement, has requirement_kind "certification";
      requirement_applicability(requirement: $law, target_system: $asset);
      # Покрытие проверяется независимо от состояния СЗИ: документ обязан
      # покрывать применимое требование, даже если все СЗИ сертифицированы.
      not { requirement_coverage(covering_document: $doc, covered_requirement: $law); };
    return { $doc, $law };

fun current_versions() -> { document_version }:
    match
      $doc isa document;
      current_version_of(document: $doc, version: $v);
    return { $v };

fun invalid_certificates($today: date) -> { security_software, certificate }:
    match
      certification(certified_software: $szi, certificate: $c);
      not {
        $c has cert_until $until;
        $until > $today;
      };
    return { $szi, $c };

# ---- проверки целостности (в TypeDB 3.14 нет @unique/@key на ролях) --
# ТипDB гарантирует только атрибутную уникальность (@key/@unique на owns).
# Всё, что касается ролей, проверяется функциями: они возвращают САМИ нарушения
# (с участниками), а не «есть/нет», чтобы было видно, что именно чинить.
# Вызывать перед коммитом загрузки документа; непустой результат — не коммитить.

fun multiple_current_versions() -> { document, document_version, document_version }:
    match
      current_version_of(document: $doc, version: $v1);
      current_version_of(document: $doc, version: $v2);
      not { $v1 is $v2; };
    return { $doc, $v1, $v2 };

fun multiple_parents() -> { structural_element, structural_element, structural_element }:
    match
      document_hierarchy(parent: $p1, child: $c);
      document_hierarchy(parent: $p2, child: $c);
      not { $p1 is $p2; };
    return { $c, $p1, $p2 };

fun element_in_multiple_structures() -> { structural_element, document_version, document_version }:
    match
      document_structure(version: $v1, element: $e);
      document_structure(version: $v2, element: $e);
      not { $v1 is $v2; };
    return { $e, $v1, $v2 };

fun elements_without_version() -> { structural_element }:
    match
      $e isa structural_element;
      not { document_structure(element: $e, version: $dv); };
    return { $e };

fun versions_without_document() -> { document_version }:
    match
      $v isa document_version;
      not { document_has_version(version: $v, document: $d); };
    return { $v };

# Текущая редакция обязана быть и в истории документа: иначе граф допускает
# current_version_of без document_has_version, и «текущая» выпадает из перечня версий.
fun current_not_in_history() -> { document, document_version }:
    match
      current_version_of(document: $doc, version: $v);
      not { document_has_version(document: $doc, version: $v); };
    return { $doc, $v };

# У нормативного акта должен быть издатель. multiple_issuers убрана (совместные
# приказы — норма), но совсем без издателя акт существовать не должен.
fun documents_without_issuer() -> { regulatory_document }:
    match
      $d isa regulatory_document;
      not { document_issuance(regulated_item: $d, issuer: $r); };
    return { $d };
